SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
GEMINI_API_KEY=your-google-ai-studio-api-key
FRONTEND_URL=http://localhost:5173

# --- Round 3 (sign-in) ---
# Turn on AFTER the SQL migration + demo users exist and the new frontend is live.
REQUIRE_AUTH=true
# Password shared by the 3 demo accounts (min 10 chars). Used by the "Sign in as ..." buttons.
DEMO_PASSWORD=choose-a-long-demo-password
ALLOW_DEMO_LOGIN=true
# SUPABASE_KEY must be the SERVICE ROLE key for sign-in and role lookups.
